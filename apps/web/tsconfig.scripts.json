{
  // Node で動くオフライン評価スクリプト用。
  // アプリ本体 (tsconfig.json) とは types が異なるため設定を分けている
  // (アプリ側に Node のグローバル型を持ち込まないため)。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["scripts/**/*", "lib/audio/basicPitchNoteDetector.ts"]
}
